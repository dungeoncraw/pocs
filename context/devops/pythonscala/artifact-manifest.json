{
  "project": "django-scala-csv-minikube",
  "language": "English",
  "architecture": "One Deployment, one Pod, three containers, one shared PVC",
  "containers": [
    "django",
    "scala-api",
    "scala-cron"
  ],
  "images": [
    "django-scala/django:dev",
    "django-scala/scala-app:dev"
  ],
  "namespace": "django-scala-local",
  "csv": {
    "path": "/data/records.csv",
    "lock_path": "/data/records.lock",
    "headers": [
      "id",
      "name",
      "value",
      "updated_at",
      "updated_by"
    ],
    "persistence": "PersistentVolumeClaim/shared-csv-data"
  },
  "apis": {
    "django": [
      "POST /api/csv/upsert/",
      "GET /api/csv/records/"
    ],
    "scala": [
      "POST /api/csv/upsert",
      "GET /api/csv/records"
    ]
  }
}
